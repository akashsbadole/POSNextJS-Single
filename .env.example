# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pharmacy_db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-secure-random-string-here"

# OAuth (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SMS/OTP — at least one provider required for OTP login
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
MSG91_AUTH_KEY=""

# Email — for password reset and notifications
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""

# Payment Gateways
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""

# AWS S3 — for prescription image uploads
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
AWS_S3_BUCKET=""

# Redis — optional, for multi-instance rate limiting and caching
REDIS_URL="redis://localhost:6379"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# AI/ML — optional
OPENAI_API_KEY=""
GOOGLE_AI_API_KEY=""

# GST API — optional, for direct GSTN e-invoice submission
GST_API_KEY=""
GST_API_URL=""

# ABDM Integration — optional, India health records
ABDM_CLIENT_ID=""
ABDM_CLIENT_SECRET=""
ABDM_BASE_URL=""

# WhatsApp — optional, for notifications and templates
WHATSAPP_API_URL=""
WHATSAPP_API_KEY=""

# Delivery — optional
DELHIVERY_API_KEY=""
SHIPROCKET_API_KEY=""
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""

# Error Tracking
SENTRY_DSN=""

# App
APP_NAME="PharmacyPro"
APP_URL="http://localhost:3000"
