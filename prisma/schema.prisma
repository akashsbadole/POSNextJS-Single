generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

model InvoiceCounter {
  id        String   @id @default(cuid())
  prefix    String   @unique
  counter   Int      @default(1)

  @@map("invoice_counters")
}

model LedgerAccount {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  type      String // ASSET | LIABILITY | EQUITY | REVENUE | EXPENSE
  createdAt DateTime @default(now()) @map("created_at")

  journalLines JournalLine[]

  @@map("ledger_accounts")
}

model JournalEntry {
  id            String   @id @default(cuid())
  entryNumber   String   @unique
  date          DateTime
  memo          String
  referenceType String?  @map("reference_type")
  referenceId   String?  @map("reference_id")
  createdById   String?
  createdAt     DateTime @default(now()) @map("created_at")

  lines JournalLine[]

  @@unique([referenceType, referenceId])
  @@map("journal_entries")
}

model JournalLine {
  id        String        @id @default(cuid())
  journalId String        @map("journal_id")
  accountId String        @map("account_id")
  debit     Float         @db.DoublePrecision @default(0)
  credit    Float         @db.DoublePrecision @default(0)
  memo      String?

  journal JournalEntry @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account LedgerAccount @relation(fields: [accountId], references: [id])

  @@map("journal_lines")
}

model RateLimitEntry {
  id        String   @id @default(cuid())
  key       String
  windowMs  Int
  createdAt DateTime @default(now())

  @@index([key, windowMs, createdAt])
  @@map("rate_limit_entries")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  phone         String?   @unique
  phoneVerified DateTime? @map("phone_verified")
  password      String?
  name          String?
  avatar        String?
  role          String    @default("CASHIER")
  status        String    @default("ACTIVE")

  twoFactorEnabled  Boolean @default(false) @map("two_factor_enabled")
  twoFactorSecret   String? @map("two_factor_secret")

  allowedIps        String  @default("[]") @map("allowed_ips")

  branchId          String? @map("branch_id")
  branch            Branch? @relation(fields: [branchId], references: [id])

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  lastLoginAt       DateTime? @map("last_login_at")
  lastLoginIp       String?  @map("last_login_ip")

  accounts          Account[]
  sessions          Session[]
  auditLogs         AuditLog[]
  sales             Sale[]
  purchases         PurchaseOrder[]
  prescriptions     Prescription[]
  notifications     Notification[]
  subscriptions     Subscription[]
  onlineOrders      OnlineOrder[]
  loyaltyPoints     LoyaltyPoint[]
  cart              Cart?
  purchaseReturns   PurchaseReturn[]

  @@map("users")
}

model Branch {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  address     String
  city        String
  state       String
  pincode     String
  phone       String?
  email       String?
  gstin       String?
  businessType String  @default("RETAIL_PHARMACY") @map("business_type")
  isActive    Boolean  @default(true) @map("is_active")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  inventories Inventory[]
  sales       Sale[]
  purchases   PurchaseOrder[]
  transfersFrom StockTransfer[] @relation("fromBranch")
  transfersTo   StockTransfer[] @relation("toBranch")
  purchaseReturns PurchaseReturn[]

  @@map("branches")
}

model Medicine {
  id              String   @id @default(cuid())
  name            String
  genericName     String   @map("generic_name")
  brandName       String?  @map("brand_name")
  description     String?

  categoryId      String   @map("category_id")
  category        Category @relation(fields: [categoryId], references: [id])

  hsnCode         String?  @map("hsn_code")
  gstRate         Float    @default(5.00) @map("gst_rate")
  scheduleType    String?  @map("schedule_type")

  dosageForm      String?  @map("dosage_form")
  strength        String?
  unitOfMeasure   String   @default("PCS") @map("unit_of_measure")

  mrp             Float    @db.DoublePrecision
  purchasePrice   Float    @db.DoublePrecision @map("purchase_price")
  sellingPrice    Float    @db.DoublePrecision @map("selling_price")

  supplierId      String?  @map("supplier_id")
  supplier        Supplier? @relation(fields: [supplierId], references: [id])

  purchaseReturnItems PurchaseReturnItem[]

  barcode         String?  @unique
  qrCode          String?  @map("qr_code")

  reorderLevel    Int      @default(10) @map("reorder_level")
  reorderQuantity Int      @default(50) @map("reorder_quantity")

  isActive        Boolean  @default(true) @map("is_active")
  isPrescriptionRequired Boolean @default(false) @map("is_prescription_required")

  images          String   @default("[]")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  inventories     Inventory[]
  batches         Batch[]
  saleItems       SaleItem[]
  purchaseItems   PurchaseOrderItem[]
  stockTransfers  StockTransferItem[]
  onlineOrderItems OnlineOrderItem[]
  subscriptionItems SubscriptionItem[]
  promiseOrders   PromiseOrder[]
  cartItems       CartItem[]

  @@index([name])
  @@index([barcode])
  @@index([categoryId])
  @@index([supplierId])
  @@index([isActive])
  @@map("medicines")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  description String?
  parentId    String?   @map("parent_id")
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")

  isActive    Boolean   @default(true) @map("is_active")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  medicines   Medicine[]

  @@map("categories")
}

model Supplier {
  id            String   @id @default(cuid())
  name          String
  contactPerson String?  @map("contact_person")
  email         String?
  phone         String?
  gstin         String?
  address       String?
  city          String?
  state         String?
  pincode       String?
  paymentTerms  String?  @map("payment_terms")

  rating        Float?
  totalOrders   Int      @default(0) @map("total_orders")

  isActive      Boolean  @default(true) @map("is_active")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  medicines     Medicine[]
  purchases     PurchaseOrder[]
  purchaseReturns PurchaseReturn[]
  payments      SupplierPayment[]

  @@map("suppliers")
}

model Inventory {
  id          String   @id @default(cuid())
  medicineId  String   @map("medicine_id")
  medicine    Medicine @relation(fields: [medicineId], references: [id])

  branchId    String   @map("branch_id")
  branch      Branch   @relation(fields: [branchId], references: [id])

  quantity    Int      @default(0)
  reservedQty Int      @default(0) @map("reserved_qty")

  mrp         Float?   @db.DoublePrecision
  sellingPrice Float?  @db.DoublePrecision @map("selling_price")

  rack        String?
  shelf       String?

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  batches     Batch[]

  @@unique([medicineId, branchId])
  @@index([branchId])
  @@map("inventories")
}

model Batch {
  id          String    @id @default(cuid())
  batchNumber String    @map("batch_number")

  medicineId  String    @map("medicine_id")
  medicine    Medicine  @relation(fields: [medicineId], references: [id])

  inventoryId String    @map("inventory_id")
  inventory   Inventory @relation(fields: [inventoryId], references: [id])

  quantity    Int
  manufacturedDate DateTime? @map("manufactured_date")
  expiryDate    DateTime  @map("expiry_date")

  purchasePrice Float   @db.DoublePrecision @map("purchase_price")
  mrp           Float   @db.DoublePrecision

  createdAt     DateTime  @default(now()) @map("created_at")

  purchaseReturnItems PurchaseReturnItem[]

  @@index([medicineId])
  @@index([expiryDate])
  @@map("batches")
}

model StockTransfer {
  id            String         @id @default(cuid())
  transferNumber String        @unique @map("transfer_number")

  fromBranchId  String        @map("from_branch_id")
  fromBranch    Branch        @relation("fromBranch", fields: [fromBranchId], references: [id])

  toBranchId    String        @map("to_branch_id")
  toBranch      Branch        @relation("toBranch", fields: [toBranchId], references: [id])

  status        String         @default("PENDING")
  notes         String?

  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  items         StockTransferItem[]

  @@index([fromBranchId, status])
  @@index([toBranchId, status])
  @@index([status, createdAt])
  @@map("stock_transfers")
}

model StockTransferItem {
  id          String        @id @default(cuid())
  transferId  String        @map("transfer_id")
  transfer    StockTransfer @relation(fields: [transferId], references: [id])

  medicineId  String        @map("medicine_id")
  medicine    Medicine      @relation(fields: [medicineId], references: [id])

  quantity    Int
  batchNumber String?       @map("batch_number")

  @@map("stock_transfer_items")
}

model Patient {
  id            String   @id @default(cuid())
  name          String
  phone         String?
  email         String?
  dateOfBirth   DateTime? @map("date_of_birth")
  age           Int?
  gender        String?
  bloodGroup    String?  @map("blood_group")
  address       String?
  city          String?
  state         String?
  pincode       String?
  gstin         String?

  allergies     String   @default("[]")
  chronicConditions String @default("[]") @map("chronic_conditions")

  // ponytail: 0 = credit sales not allowed; outstanding = sum of PENDING sales, checked at POS
  creditLimit   Float    @default(0) @map("credit_limit")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  prescriptions Prescription[]
  sales         Sale[]

  @@map("patients")
}

model Doctor {
  id            String   @id @default(cuid())
  name          String
  rmpNumber     String?  @unique @map("rmp_number")
  specialty     String?
  clinicName    String?  @map("clinic_name")
  clinicAddress String?  @map("clinic_address")
  phone         String?
  email         String?

  isVerified    Boolean  @default(false) @map("is_verified")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  prescriptions Prescription[]

  @@map("doctors")
}

model Prescription {
  id            String             @id @default(cuid())
  prescriptionNumber String        @unique @map("prescription_number")

  patientId     String             @map("patient_id")
  patient       Patient            @relation(fields: [patientId], references: [id])

  doctorId      String?            @map("doctor_id")
  doctor        Doctor?            @relation(fields: [doctorId], references: [id])

  imageUrl      String?            @map("image_url")
  ocrText       String?            @map("ocr_text")

  abdmId        String?            @map("abdm_id")
  ePrescriptionId String?          @map("e_prescription_id")

  status        String             @default("PENDING")

  createdById   String             @map("created_by_id")
  createdBy     User               @relation(fields: [createdById], references: [id])

  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  items         PrescriptionItem[]
  sales         Sale[]

  @@map("prescriptions")
}

model PrescriptionItem {
  id              String       @id @default(cuid())
  prescriptionId  String       @map("prescription_id")
  prescription    Prescription @relation(fields: [prescriptionId], references: [id])

  medicineName    String       @map("medicine_name")
  dosage          String?
  frequency       String?
  duration        String?
  quantity        Int?
  instructions    String?

  isDispensed     Boolean      @default(false) @map("is_dispensed")
  dispensedQty    Int          @default(0) @map("dispensed_qty")

  @@map("prescription_items")
}

model Sale {
  id            String       @id @default(cuid())
  invoiceNumber String       @unique @map("invoice_number")

  branchId      String       @map("branch_id")
  branch        Branch       @relation(fields: [branchId], references: [id])

  patientId     String?      @map("patient_id")
  patient       Patient?     @relation(fields: [patientId], references: [id])

  prescriptionId String?     @map("prescription_id")
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id])

  cashierId     String       @map("cashier_id")
  cashier       User         @relation(fields: [cashierId], references: [id])

  subtotal      Float        @db.DoublePrecision
  discountAmount Float     @default(0.00) @db.DoublePrecision @map("discount_amount")
  discountType  String?      @map("discount_type")
  discountValue Float?       @db.DoublePrecision @map("discount_value")

  taxableAmount Float        @db.DoublePrecision @map("taxable_amount")
  cgstAmount    Float        @db.DoublePrecision @map("cgst_amount")
  sgstAmount    Float        @db.DoublePrecision @map("sgst_amount")
  igstAmount    Float        @default(0.00) @db.DoublePrecision @map("igst_amount")
  totalGst      Float        @db.DoublePrecision @map("total_gst")

  totalAmount   Float        @db.DoublePrecision @map("total_amount")
  roundOff      Float        @default(0.00) @db.DoublePrecision @map("round_off")
  finalAmount   Float        @db.DoublePrecision @map("final_amount")

  paymentMode   String       @map("payment_mode")
  paymentStatus String       @default("PAID") @map("payment_status")

  isGstInvoice  Boolean      @default(true) @map("is_gst_invoice")
  eInvoiceId    String?      @map("e_invoice_id")

  loyaltyPointsEarned Int    @default(0) @map("loyalty_points_earned")
  loyaltyPointsUsed   Int    @default(0) @map("loyalty_points_used")
  loyaltyDiscount     Float  @default(0.00) @db.DoublePrecision @map("loyalty_discount")

  status        String       @default("PENDING")
  notes         String?

  salesmanId    String?      @map("salesman_id")
  salesman      Salesman?    @relation(fields: [salesmanId], references: [id])

  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  items         SaleItem[]
  payments      Payment[]
  returns       SaleReturn[]

  @@index([createdAt])
  @@index([branchId])
  @@index([cashierId])
  @@index([paymentStatus])
  @@index([branchId, createdAt])
  @@index([paymentStatus, createdAt])
  @@map("sales")
}

model Salesman {
  id             String   @id @default(cuid())
  name           String
  phone          String?
  commissionRate Float    @default(0) @db.DoublePrecision @map("commission_rate") // percent of sale value
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  sales Sale[]

  @@map("salesmen")
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String   @map("sale_id")
  sale        Sale     @relation(fields: [saleId], references: [id])

  medicineId  String   @map("medicine_id")
  medicine    Medicine @relation(fields: [medicineId], references: [id])

  batchNumber String?  @map("batch_number")
  quantity    Int
  unitPrice   Float    @db.DoublePrecision @map("unit_price")
  mrp         Float    @db.DoublePrecision

  gstRate     Float    @map("gst_rate")
  cgstAmount  Float    @db.DoublePrecision @map("cgst_amount")
  sgstAmount  Float    @db.DoublePrecision @map("sgst_amount")

  discountAmount Float  @default(0.00) @db.DoublePrecision @map("discount_amount")
  totalAmount Float    @db.DoublePrecision @map("total_amount")

  returnedQty Int      @default(0) @map("returned_qty")

  @@map("sale_items")
}

model Payment {
  id          String        @id @default(cuid())
  saleId      String        @map("sale_id")
  sale        Sale          @relation(fields: [saleId], references: [id])

  amount      Float         @db.DoublePrecision
  mode        String

  transactionId String?     @map("transaction_id")
  upiId       String?       @map("upi_id")
  cardLast4   String?       @map("card_last_4")

  status      String        @default("PENDING")

  createdAt   DateTime      @default(now()) @map("created_at")

  @@map("payments")
}

model SaleReturn {
  id          String   @id @default(cuid())
  returnNumber String  @unique @map("return_number")

  saleId      String   @map("sale_id")
  sale        Sale     @relation(fields: [saleId], references: [id])

  reason      String
  refundAmount Float   @db.DoublePrecision @map("refund_amount")
  refundMode  String   @map("refund_mode")

  status      String   @default("PENDING")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items       SaleReturnItem[]

  @@map("sale_returns")
}

model SaleReturnItem {
  id          String     @id @default(cuid())
  returnId    String     @map("return_id")
  return      SaleReturn @relation(fields: [returnId], references: [id])

  medicineId  String     @map("medicine_id")
  quantity    Int
  unitPrice   Float      @db.DoublePrecision @map("unit_price")
  refundAmount Float    @db.DoublePrecision @map("refund_amount")
  reason      String?

  @@map("sale_return_items")
}

model PurchaseOrder {
  id          String         @id @default(cuid())
  poNumber    String         @unique @map("po_number")

  branchId    String         @map("branch_id")
  branch      Branch         @relation(fields: [branchId], references: [id])

  supplierId  String         @map("supplier_id")
  supplier    Supplier       @relation(fields: [supplierId], references: [id])

  createdById String         @map("created_by_id")
  createdBy   User           @relation(fields: [createdById], references: [id])

  status      String         @default("DRAFT")

  subtotal    Float          @db.DoublePrecision
  discountAmount Float      @default(0.00) @db.DoublePrecision @map("discount_amount")
  taxableAmount Float        @db.DoublePrecision @map("taxable_amount")
  cgstAmount  Float          @db.DoublePrecision @map("cgst_amount")
  sgstAmount  Float          @db.DoublePrecision @map("sgst_amount")
  totalAmount Float          @db.DoublePrecision @map("total_amount")

  expectedDeliveryDate DateTime? @map("expected_delivery_date")

  notes       String?

  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  items       PurchaseOrderItem[]
  grns        GRN[]
  purchaseReturns PurchaseReturn[]

  @@index([status])
  @@index([branchId])
  @@map("purchase_orders")
}

model PurchaseReturn {
  id           String   @id @default(cuid())
  returnNumber String   @unique @map("return_number")

  poId         String?  @map("po_id")
  po           PurchaseOrder? @relation(fields: [poId], references: [id])

  branchId     String   @map("branch_id")
  branch       Branch   @relation(fields: [branchId], references: [id])

  supplierId   String   @map("supplier_id")
  supplier     Supplier @relation(fields: [supplierId], references: [id])

  returnDate   DateTime @default(now()) @map("return_date")
  reason       String?

  subtotal     Float    @db.DoublePrecision
  cgstAmount   Float    @default(0) @db.DoublePrecision @map("cgst_amount")
  sgstAmount   Float    @default(0) @db.DoublePrecision @map("sgst_amount")
  totalGst     Float    @default(0) @db.DoublePrecision @map("total_gst")
  totalAmount  Float    @db.DoublePrecision @map("total_amount")
  status       String   @default("COMPLETED")

  createdById  String   @map("created_by_id")
  createdBy    User     @relation(fields: [createdById], references: [id])

  items        PurchaseReturnItem[]
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id          String          @id @default(cuid())
  returnId    String          @map("return_id")
  return      PurchaseReturn  @relation(fields: [returnId], references: [id])

  medicineId  String          @map("medicine_id")
  medicine    Medicine        @relation(fields: [medicineId], references: [id])
  batchId     String?         @map("batch_id")
  batch       Batch?          @relation(fields: [batchId], references: [id])

  quantity    Int
  unitPrice   Float           @db.DoublePrecision @map("unit_price")
  gstRate     Float           @map("gst_rate")
  totalAmount Float           @db.DoublePrecision @map("total_amount")

  @@map("purchase_return_items")
}

model PurchaseOrderItem {
  id          String        @id @default(cuid())
  poId        String        @map("po_id")
  po          PurchaseOrder @relation(fields: [poId], references: [id])

  medicineId  String        @map("medicine_id")
  medicine    Medicine      @relation(fields: [medicineId], references: [id])

  quantity    Int
  receivedQty Int           @default(0) @map("received_qty")
  unitPrice   Float         @db.DoublePrecision @map("unit_price")
  gstRate     Float         @map("gst_rate")
  totalAmount Float         @db.DoublePrecision @map("total_amount")

  @@map("purchase_order_items")
}

model GRN {
  id          String   @id @default(cuid())
  grnNumber   String   @unique @map("grn_number")

  poId        String   @map("po_id")
  po          PurchaseOrder @relation(fields: [poId], references: [id])

  receivedDate DateTime @map("received_date")

  hasDiscrepancy Boolean @default(false) @map("has_discrepancy")
  discrepancyNotes String? @map("discrepancy_notes")

  createdAt   DateTime @default(now()) @map("created_at")

  items       GRNItem[]

  @@map("grns")
}

model GRNItem {
  id          String   @id @default(cuid())
  grnId       String   @map("grn_id")
  grn         GRN      @relation(fields: [grnId], references: [id])

  medicineId  String   @map("medicine_id")

  orderedQty  Int      @map("ordered_qty")
  receivedQty Int      @map("received_qty")
  acceptedQty Int      @map("accepted_qty")
  rejectedQty Int      @default(0) @map("rejected_qty")

  batchNumber String   @map("batch_number")
  expiryDate  DateTime @map("expiry_date")

  unitPrice   Float    @db.DoublePrecision @map("unit_price")

  @@map("grn_items")
}

model SupplierPayment {
  id          String   @id @default(cuid())
  supplierId  String   @map("supplier_id")
  supplier    Supplier @relation(fields: [supplierId], references: [id])

  amount      Float    @db.DoublePrecision
  mode        String
  transactionId String? @map("transaction_id")

  notes       String?

  createdAt   DateTime @default(now()) @map("created_at")

  @@map("supplier_payments")
}

model OnlineOrder {
  id          String      @id @default(cuid())
  orderNumber String      @unique @map("order_number")

  customerId  String      @map("customer_id")
  customer    User        @relation(fields: [customerId], references: [id])

  shippingAddress String  @map("shipping_address")
  shippingCity    String  @map("shipping_city")
  shippingState   String  @map("shipping_state")
  shippingPincode String  @map("shipping_pincode")

  deliverySlot  String?   @map("delivery_slot")
  deliveryDate  DateTime? @map("delivery_date")

  trackingNumber String?  @map("tracking_number")
  courierPartner String?  @map("courier_partner")

  subtotal      Float     @db.DoublePrecision
  deliveryCharge Float    @default(0.00) @db.DoublePrecision @map("delivery_charge")
  discountAmount Float    @default(0.00) @db.DoublePrecision @map("discount_amount")
  totalAmount   Float     @db.DoublePrecision

  paymentMode   String
  paymentStatus String    @default("PENDING") @map("payment_status")

  status        String    @default("PENDING")

  prescriptionId String?   @map("prescription_id")
  prescriptionVerified Boolean @default(false) @map("prescription_verified")

  notes         String?

  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  items         OnlineOrderItem[]

  @@index([customerId, status])
  @@index([status, createdAt])
  @@index([paymentStatus])
  @@map("online_orders")
}

model OnlineOrderItem {
  id          String      @id @default(cuid())
  orderId     String      @map("order_id")
  order       OnlineOrder @relation(fields: [orderId], references: [id])

  medicineId  String      @map("medicine_id")
  medicine    Medicine    @relation(fields: [medicineId], references: [id])

  quantity    Int
  unitPrice   Float       @db.DoublePrecision
  totalAmount Float       @db.DoublePrecision @map("total_amount")

  @@map("online_order_items")
}

model Subscription {
  id          String              @id @default(cuid())

  customerId  String              @map("customer_id")
  customer    User                @relation(fields: [customerId], references: [id])

  name        String
  frequency   String

  subtotal    Float               @db.DoublePrecision
  deliveryCharge Float           @default(0.00) @db.DoublePrecision @map("delivery_charge")
  totalAmount Float               @db.DoublePrecision @map("total_amount")

  status      String              @default("ACTIVE")

  nextDeliveryDate DateTime       @map("next_delivery_date")

  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  items       SubscriptionItem[]
  deliveries  SubscriptionDelivery[]

  @@index([status, nextDeliveryDate])
  @@index([customerId, status])
  @@map("subscriptions")
}

model SubscriptionItem {
  id          String       @id @default(cuid())
  subscriptionId String    @map("subscription_id")
  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  medicineId  String       @map("medicine_id")
  medicine    Medicine    @relation(fields: [medicineId], references: [id])

  quantity    Int
  unitPrice   Float        @db.DoublePrecision

  @@map("subscription_items")
}

model SubscriptionDelivery {
  id          String       @id @default(cuid())
  subscriptionId String    @map("subscription_id")
  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  scheduledDate DateTime   @map("scheduled_date")
  deliveredDate DateTime?  @map("delivered_date")
  status      String       @default("SCHEDULED")

  @@map("subscription_deliveries")
}

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String  @map("cart_id")
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)

  medicineId String @map("medicine_id")
  medicine   Medicine @relation(fields: [medicineId], references: [id])
  quantity   Int

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([cartId, medicineId])
  @@map("cart_items")
}

model LoyaltyPoint {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id])

  points      Int
  type        String

  saleId      String?  @map("sale_id")
  description String?

  expiresAt   DateTime? @map("expires_at")

  createdAt   DateTime @default(now()) @map("created_at")

  @@map("loyalty_points")
}

model LoyaltyTier {
  id          String   @id @default(cuid())
  name        String
  minPoints   Int      @map("min_points")
  maxPoints   Int?     @map("max_points")
  discountPercent Float @map("discount_percent")

  isActive    Boolean  @default(true) @map("is_active")

  @@map("loyalty_tiers")
}

model AuditLog {
  id          String      @id @default(cuid())
  userId      String      @map("user_id")
  user        User        @relation(fields: [userId], references: [id])

  action      String
  entityType  String      @map("entity_type")
  entityId    String?     @map("entity_id")

  oldData     String?     @map("old_data")
  newData     String?     @map("new_data")

  ipAddress   String?     @map("ip_address")
  userAgent   String?     @map("user_agent")

  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id          String              @id @default(cuid())
  userId      String              @map("user_id")
  user        User                @relation(fields: [userId], references: [id])

  type        String
  title       String
  message     String

  channels    String              @default("[]")

  isRead      Boolean             @default(false) @map("is_read")

  entityType  String?             @map("entity_type")
  entityId    String?             @map("entity_id")

  createdAt   DateTime            @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@map("notifications")
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  category    String   @default("GENERAL")
  description String?

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model Expense {
  id          String   @id @default(cuid())
  category    String
  description String
  amount      Float    @db.DoublePrecision
  date        DateTime

  branchId    String?  @map("branch_id")

  receiptUrl  String?  @map("receipt_url")

  createdAt   DateTime @default(now()) @map("created_at")

  @@map("expenses")
}

model CustomFieldDefinition {
  id          String   @id @default(cuid())
  entityType  String   @map("entity_type")
  fieldName   String   @map("field_name")
  fieldType   String   @map("field_type")  // TEXT | NUMBER | BOOLEAN | DATE | SELECT | MULTISELECT
  options     String?  // JSON array for SELECT/MULTISELECT
  isRequired  Boolean  @default(false) @map("is_required")
  placeholder String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  values      CustomFieldValue[]

  @@unique([entityType, fieldName])
  @@map("custom_field_definitions")
}

model CustomFieldValue {
  id          String              @id @default(cuid())
  entityType  String              @map("entity_type")
  entityId    String              @map("entity_id")
  fieldId     String              @map("field_id")
  field       CustomFieldDefinition @relation(fields: [fieldId], references: [id])
  value       String

  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@unique([entityType, entityId, fieldId])
  @@map("custom_field_values")
}

model DrugLicense {
  id              String   @id @default(cuid())
  licenseType     String   @map("license_type")  // DL_21B | DL_20B | RETAIL | WHOLESALE
  licenseNumber   String   @map("license_number")
  holderName      String   @map("holder_name")
  holderType      String   @map("holder_type")  // SUPPLIER | BRANCH
  holderId        String   @map("holder_id")
  issuingAuthority String? @map("issuing_authority")
  issueDate       DateTime? @map("issue_date")
  expiryDate      DateTime  @map("expiry_date")
  isActive        Boolean  @default(true) @map("is_active")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([licenseNumber])
  @@index([holderType, holderId])
  @@map("drug_licenses")
}

model Scheme {
  id            String    @id @default(cuid())
  name          String
  description   String?
  schemeType    String    @map("scheme_type")  // FREE_GOODS | CASH_DISCOUNT | COMBO | BULK_DISCOUNT
  conditions    String?   // JSON: conditions to trigger scheme
  rewards       String?   // JSON: what the scheme gives
  priority      Int       @default(0)
  isActive      Boolean   @default(true) @map("is_active")
  validFrom     DateTime? @map("valid_from")
  validTo       DateTime? @map("valid_to")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("schemes")
}

model PromiseOrder {
  id             String    @id @default(cuid())
  customerName   String    @map("customer_name")
  customerPhone  String?   @map("customer_phone")
  medicineId     String    @map("medicine_id")
  medicine       Medicine  @relation(fields: [medicineId], references: [id])
  quantity       Int
  notes          String?
  status         String    @default("PENDING")  // PENDING | FULFILLED | CANCELLED
  fulfilledAt    DateTime? @map("fulfilled_at")

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("promise_orders")
}